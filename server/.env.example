PORT=3000
API_PREFIX=v1
STORAGE_DIR=./storage
MAX_MANUAL_PAGES=80
MAX_IMAGE_SIZE_MB=12

# Qwen through Alibaba Cloud Model Studio. Never expose this key to iOS.
DASHSCOPE_API_KEY=
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_FLASH_MODEL=qwen3.7-flash
QWEN_PLUS_MODEL=qwen3.7-plus
# The qwen3.7-max alias is text-only. This pinned snapshot accepts images.
QWEN_MAX_MODEL=qwen3.7-max-2026-06-08
# Token Plan only. This preview model requires thinking mode.
QWEN_38_MAX_MODEL=qwen3.8-max-preview
QWEN_38_REASONING_EFFORT=medium
QWEN_OCR_MODEL=qwen3.5-ocr
# OpenAI Responses API. Never expose this key to iOS.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1

# Independent OCR helper: qwen or tencent.
OCR_PROVIDER=qwen
TENCENTCLOUD_SECRET_ID=
TENCENTCLOUD_SECRET_KEY=
TENCENTCLOUD_REGION=ap-guangzhou

# Keep true during local UI development. Set false after configuring the API key.
QWEN_MOCK=true
